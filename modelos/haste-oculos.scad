// Eixo solidário à haste. As faces esféricas trabalham nos dois alojamentos.
// O seletor "pino" exibe somente este detalhe para inspeção.
module arm_axis() {
  cylinder(d=stem,h=pin_span,center=true,$fn=64);
  for(z=[-pin_span/2,pin_span/2]) translate([0,0,z]) sphere(d=ball,$fn=48);
}

module arm_with_pin() {
  union() {
    arm();
    // Preenche o furo e une o eixo à haste. Conserva a folga radial da forquilha.
    cylinder(r=3.40,h=pin_span-3.14,center=true,$fn=64);
    arm_axis();
  }
}

// A montagem usa uma barra e duas hastes. A lente serve de referência.
module conjunto() {
  color([.16,.25,.24]) front();
  color([.49,.77,.78,.42]) lens();
  for (s=[-1,1])
    scale([s,1,1]) translate([pivot_x(),pivot_y(),15])
      color([.27,.40,.39]) arm_with_pin();
}
if (part=="barra") front();
else if (part=="haste_d") arm_with_pin();
else if (part=="haste_e") mirror([1,0,0]) arm_with_pin();
else if (part=="pino") arm_axis();
else if (part=="gabarito") gauge();
else if (part=="lente") lens();
else if (part=="conjunto") conjunto();
else assert(false, "Selecione uma peça válida em part.");
