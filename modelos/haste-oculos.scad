// Haste para óculos de lente panorâmica • editor paramétrico do conjunto em milímetros para a Bambu Lab A1.
// A lente é uma referência de ajuste. A resistência a impacto exige ensaio.
/* [Peça] */
part = "conjunto"; // [conjunto,barra,haste_d,haste_e,pino,gabarito,lente]

/* [Encaixe da lente] */
// Da ponta livre da aba à face distante do ressalto, em Y (Medida).
shoulder = 3.9; // [3.4:0.05:4.2]
// Altura da aba lisa (Medida).
edge = 2; // [2.0:0.05:2.8]
// Altura da aba com ressalto (Medida).
raised = 3; // [2.75:0.05:3.8]
// Distância frontal entre os centros dos ressaltos, em X (Medida).
spacing = 37; // [32:0.1:42]
// Largura frontal do ressalto em X (Medida).
boss_width = 8; // [6:0.1:10]
// Comprimento do pé do ressalto em Y (Medida).
boss_depth = 1; // [0.6:0.05:1.4]

/* [Barra superior] */
// Entrada frontal (Medida).
insertion = 5.2; // [4.7:0.05:5.8]
// Folga vertical total (Projeto).
slack = 0.3; // [0.15:0.05:0.55]
// Interferência da trava (Projeto).
snap = 0.2; // [0.05:0.05:0.35]

/* [Lente de referência] */
// Largura em linha reta (Medida).
chord = 150; // [146:0.1:155]
// Profundidade do arco (Estimativa).
sag = 42; // [25:0.05:45]
// Do nariz ao topo (Medida).
nose = 26; // [23:0.1:29]
// Espessura da borda do visor em Y (mesmo nominal da lente).
rim = 2; // [1.6:0.05:2.6]
// Comprimento da aba em Y (Pontos a confirmar).
side_depth = 6; // [4:0.1:8]

/* [Hastes] */
// Comprimento da haste em Y (Projeto).
arm_length = 130; // [118:0.5:142]

/* [Pino e dobradiça] */
// Diâmetro das esferas (Projeto).
ball = 3.7; // [3.5:0.05:4.0]
// Diâmetro do eixo (Projeto).
stem = 3.2; // [2.9:0.05:3.35]
// Entre centros das esferas (Projeto).
pin_span = 6.8; // [6.4:0.1:7.2]
// Folga diametral no assento da esfera (Projeto A1 · validar em PETG).
socket_clear = 0.30; // [0.2:0.05:0.5]
// Interferência diametral da garganta (Projeto A1 · validar em PETG).
throat_retention = 0.16; // [0.08:0.01:0.24]

/* [Hidden] */
// Barra superior. X atravessa a lente. +Y aponta para o usuário, Z para cima.
// A linha central reutiliza os pontos e as tangentes PCHIP do traçado do P1.
// chord é a largura frontal entre pontas. sag é a profundidade no plano XY.
_of_x = [0,10,20,30,40,48,55,60,64,68,72,75.55];
_of_y = [0,1,6,15,27,46,72,101,121,151,175,196];
_of_m = [0,0.166667,0.642857,1.028571,1.614053,2.911591,4.584361,
         5.355677,6,6.666667,5.956607,5.875758];

function _of_segment(x, j=0) = j >= len(_of_x)-2 || x <= _of_x[j+1] ? j : _of_segment(x,j+1);
function _of_trace(x) = x >= 75.55 ? 196+(x-75.55)*_of_m[len(_of_m)-1] :
    let(i=_of_segment(x), h=_of_x[i+1]-_of_x[i], t=(x-_of_x[i])/h)
    (2*t*t*t-3*t*t+1)*_of_y[i] + (t*t*t-2*t*t+t)*h*_of_m[i] +
    (-2*t*t*t+3*t*t)*_of_y[i+1] + (t*t*t-t*t)*h*_of_m[i+1];
function rail_y(x) = 4 + sag*_of_trace(abs(x)*151.10/chord)/196;
// O pivô acompanha em Y a diferença de flecha entre o traçado inicial e a lente.
function pivot_x() = 73.64;
function pivot_y() = 45+(sag-29.65);
function _of_ring(x, coords) = [for (p=coords) [x,rail_y(x)+p[0],p[1]]];

module _of_sweep(rings) {
    n=len(rings[0]);
    k=len(rings);
    polyhedron(points=[for (ring=rings) each ring], faces=concat(
        [[for(j=[0:n-1]) j]],
        [for(i=[0:k-2],j=[0:n-1]) each
            let(a=i*n+j, b=i*n+(j+1)%n) [[a,a+n,b],[b,a+n,b+n]]],
        [[for(j=[n-1:-1:0]) (k-1)*n+j]]
    ), convexity=12);
}
function _of_stations(a,b) = let(n=max(1,ceil((b-a)/1.20))) [for(i=[0:n]) a+(b-a)*i/n];

function _of_channel_end() = chord/2+.35;
function _of_shell_end() = chord/2+1.70;
function _of_stop() = insertion+.15;
function _of_floor() = 13-slack/2;
function _of_smooth_ceiling() = 13+edge+slack/2;
function _of_boss_ceiling() = 13+raised+slack/2;
function _of_floor_mouth() = max(0,insertion-side_depth+edge+slack/2);
function _of_shell_back() = _of_stop()+1.65;
function _of_shell_top() = _of_boss_ceiling()+1.70;
function _of_seat_extent() = boss_width/2+.65;
function _of_fraction(s) = let(d=min([for(c=[-spacing,0,spacing]) abs(s-c)]))
    min(1,max(0,(_of_seat_extent()-d)/.45));

module _of_shell() {
    b=_of_shell_back();
    z=_of_shell_top();
    sec=[[0,11.15],[b-.25,11.15],[b,11.40],[b,z-.35],[b-.35,z],[.3,z],[0,z-.30]];
    _of_sweep([for(s=_of_stations(-_of_shell_end(),_of_shell_end())) _of_ring(s,sec)]);
}
// O trecho dianteiro acompanha a nova flecha. A extremidade traseira translada
// como corpo rígido para conservar a união da longarina com a dobradiça.
module _of_bone_slice(lo,hi,ys,yoff) {
    translate([0,yoff,0]) scale([1.052,ys,1]) intersection() {
        p0_front();
        translate([-100,lo,8]) cube([200,hi-lo,18]);
    }
}
module _of_bone() {
    ratio=sag/29.65;
    split=4+29.65;
    delta=sag-29.65;
    if(abs(ratio-1)<0.00001)
        _of_bone_slice(-5,41.45,1,0);
    else {
        _of_bone_slice(-5,split+.015,ratio,4*(1-ratio));
        _of_bone_slice(split-.015,41.45,1,delta);
    }
}


// O mesmo recorte abre a boca na frente do P0, o canal horizontal e o espaço
// do visor sob a aba. A superfície posterior da cavidade é o batente.
// Na ponta, a folga lateral de 0,35 é medida em X, como a largura da lente.
// O fundo do alojamento da trava fica logo após o ressalto assentado.
function _of_pocket_back() = insertion-shoulder+boss_depth+.18;
function _of_channel_section(s) =
    let(p=_of_fraction(s), z=_of_smooth_ceiling()+(raised-edge)*p,
        f=_of_floor(), m=_of_floor_mouth(), b=_of_stop())
    [[-82,5],[m,5],[m,f-.35],[m+.22,f],[b,f],[b,_of_smooth_ceiling()],
     [_of_pocket_back()+.12,_of_smooth_ceiling()],[_of_pocket_back(),z],
     [.24,z],[0,z+.20],[0,27],[-82,27]];
module _of_channel() {
    k=_of_seat_extent();
    lim=_of_channel_end();
    stops=concat([-lim],[for(c=[-spacing,0,spacing]) each [c-k,c-k+.45,c+k-.45,c+k]],[lim]);
    stations=concat([for(i=[0:len(stops)-2]) each
        let(a=stops[i], b=stops[i+1], n=max(1,ceil((b-a)/.82)))
        [for(j=[0:n-1]) a+(b-a)*j/n]], [lim]);
    _of_sweep([for(s=stations) _of_ring(s,_of_channel_section(s))]);
}

// As três janelas abrem-se na superfície superior da barra, sobre os
// ressaltos. A parede traseira permanece contínua atrás das três aberturas.
function _of_window_width(c) = boss_width+(abs(c)<.01 ? 5.1 : 3.9);
function _of_latch_rear() = insertion-shoulder-.12;
function _of_latch_lead() = max(.035,_of_latch_rear()-min(1.35,.76*_of_latch_rear()));
module _of_window(c) {
    w=_of_window_width(c)/2;
    d0=max(.01,min(.18,_of_latch_lead()-.13));
    d1=_of_pocket_back()+.04;
    z=_of_smooth_ceiling()-.04;
    stations=concat([[-w,.24]], [for(x=_of_stations(-w+.30,w-.30)) [x,0]], [[w,.24]]);
    _of_sweep([for(p=stations)
        _of_ring(c+p[0],[[d0+p[1],z],[d1-p[1],z],[d1-p[1],27],[d0+p[1],27]])]);
}

// Mola de duas raízes, longitudinalmente curta e flexível em Z. Na
// aproximação o ressalto sobe sob a rampa. Quando assenta, a face dianteira
// do ressalto fica 0,12 mm atrás da face de retenção da mola.
module _of_leaf(c) {
    w=_of_window_width(c)/2;
    wide=min(boss_width*.40,w-.95);
    d0=_of_latch_lead();
    d1=_of_latch_rear();
    toe=d1-min(.24,.20*(d1-d0));
    ds=min(_of_stop()-.10,d1+.28);
    base=_of_boss_ceiling()+.05;
    tip=_of_floor()+raised-snap;
    stations=[[-w-1.35,0],[-w+.65,0],[-wide,0],[-wide*.48,.72],
              [-wide*.34,1],[0,1],[wide*.34,1],[wide*.48,.72],
              [wide,0],[w-.65,0],[w+1.35,0]];
    _of_sweep([for(p=stations) let(z=base-.035-(base-.035-tip)*p[1])
        _of_ring(c+p[0],[[d0,base],[toe,z],[d1,z],[d1,base],
                          [ds,base],[ds,base+.91],[d0,base+.91]])]);
}
module _of_rail(with_hinges=false) {
    union() {
        difference() {
            union() {
                difference() {
                    union() {
                        _of_bone();
                        _of_shell();
                    }
                    // Em flechas maiores, o fim da barra alcança o raio varrido
                    // pelo mancal. Reserve 0,25 mm radiais e 0,20 mm por face.
                    for(side=[-1,1])
                        translate([side*pivot_x(),pivot_y(),15])
                            cylinder(r=3.85+.25,h=pin_span-3.14+.40,center=true,$fn=96);
                }
                if(with_hinges) {
                    translate([pivot_x(),pivot_y(),15]) hinge();
                    mirror([1,0,0]) translate([pivot_x(),pivot_y(),15]) hinge();
                }
            }
            _of_channel();
            for(c=[-spacing,0,spacing]) _of_window(c);
        }
        for(c=[-spacing,0,spacing]) _of_leaf(c);
    }
}
module front() { _of_rail(true); }
module gauge() {
    // Mesmo canal, batente e três molas. O recorte retira aletas e dobradiças.
    z=_of_shell_top()+.13;
    b=_of_shell_back();
    sec=[[-.12,11.15],[b,11.15],[b,z],[-.12,z]];
    intersection() {
        _of_rail(false);
        _of_sweep([for(s=_of_stations(-_of_shell_end(),_of_shell_end())) _of_ring(s,sec)]);
    }
}

// Haste, dobradiça e pino do protótipo P1. A origem de cada peça é o
// centro do pivô direito. X aponta para fora, Y para a orelha, Z para cima.
module part_box(x0, x1, y0, y1, z0, z1) {
    translate([x0,y0,z0]) cube([x1-x0,y1-y0,z1-z0]);
}

module part_slot(stations, z0, z1) {
    translate([0,0,z0]) linear_extrude(z1-z0)
        polygon(concat([for (s = stations) [-s[1]/2,s[0]]],
                       [for (i = [len(stations)-1:-1:0])
                           [stations[i][1]/2,stations[i][0]]]));
}

// Entrada cônica pelo lado da orelha. A garganta retém a cabeça esférica.
module part_ball_socket(z) {
    d = ball + socket_clear;
    throat_r = (ball-throat_retention)/2;
    assert(throat_retention > 0 && throat_retention < ball && socket_clear > 0);
    translate([0,0,z]) {
        sphere(d=d, $fn=48);
        rotate([-90,0,0]) rotate_extrude($fn=48)
            polygon([[0,0], [throat_r,0], [throat_r,2.20],
                     [ball/2+0.330,3.90], [ball/2+0.450,5.50], [0,5.50]]);
    }
}

module hinge() {
    r = ball/2 + 2.400;
    half_span = pin_span/2;
    inner_z = half_span-1.17;
    outer_z = half_span+1.60;
    stem_gap = stem+0.36;
    assert(inner_z > 0 && ball > stem && socket_clear > 0);
    union() {
        difference() {
            union() for (sign_z = [-1,1]) {
                z0 = sign_z > 0 ? inner_z : -outer_z;
                translate([0,0,z0]) cylinder(h=outer_z-inner_z,r=r,$fn=64);
                part_box(-2.8,2.8,-5.65,-2.0,z0,z0+outer_z-inner_z);
            }
            for (sign_z = [-1,1]) {
                part_ball_socket(sign_z*half_span);
                z0 = sign_z > 0 ? inner_z-0.01 : -half_span+0.20;
                z1 = sign_z > 0 ? half_span-0.20 : -inner_z+0.01;
                part_slot([[-0.12,stem_gap],[2.25,stem_gap],[5.50,stem_gap+0.59]],z0,z1);
                translate([0,0,z0]) cylinder(h=z1-z0,d=stem_gap+0.04,$fn=48);
            }
        }
        part_box(r-0.33,r+0.85,-1.15,8.05,-2.8,2.8);
    }
}

module arm() {
    bearing_h = pin_span-3.14;
    root_h = bearing_h-0.22;
    throat = stem-0.20;
    crop_y = 2.80;
    assert(arm_length > crop_y && bearing_h > 0 && throat > 0);
    difference() {
        union() {
            cylinder(h=bearing_h,r=3.85,center=true,$fn=64);
            part_box(-2.34,2.34,1.95,4.50,-root_h/2,root_h/2);
            // O olho mantém seu diâmetro quando o usuário muda o comprimento.
            translate([0,crop_y,0]) scale([1,(arm_length-crop_y)/(130-crop_y),1])
                translate([0,-crop_y,0]) intersection() {
                    translate([-70,-45,-15]) p0_arm();
                    part_box(-70,8,crop_y,140,-20,20);
                }
        }
        cylinder(h=bearing_h+0.80,d=stem+0.35,center=true,$fn=64);
        part_slot([[-4.4,throat+0.85],[-2.85,throat],[-0.65,throat]],
                  -bearing_h/2-0.40,bearing_h/2+0.40);
    }
}

module pin() {
    h = pin_span/2;
    r = ball/2;
    assert(ball > stem && stem > 0.60 && h > 0);
    intersection() {
        union() {
            cylinder(d=stem,h=pin_span,center=true,$fn=64);
            for (z = [-h,h]) translate([0,0,z]) sphere(d=ball,$fn=48);
        }
        // Face plana do P1 para apoiar o pino deitado na mesa.
        part_box(-r-1,r+1,-stem/2+0.30,r+1,-h-r-1,h+r+1);
    }
}

// Superfície ilustrativa da lente existente. As medidas pertencem à borda.
// A silhueta inferior é estimada, com a altura central registrada pelo nariz.
function lens_lower_depth(x) =
    let(u=min(1,abs(x)/(chord/2)), side_drop=insertion+3.8)
    side_drop + (nose+16-side_drop)*sqrt(max(0,1-pow(u,3)))
        -16*exp(-pow(u/0.15,2));

// As estações usam a projeção frontal em X. Todos os pontos de uma
// seção conservam o mesmo X. d = Y - rail_y(X), positivo para trás.
function lens_stations() =
    let(breaks=concat([-chord/2],
              [for(c=[-spacing,0,spacing], offset=[-boss_width/2,0,boss_width/2])
                   c+offset], [chord/2]))
    concat([for(i=[0:len(breaks)-2])
                let(a=breaks[i],b=breaks[i+1],n=max(1,ceil((b-a)/0.75)))
                for(k=[0:n-1]) a+(b-a)*k/n], [chord/2]);

function lens_smooth(t) = t*t*(3-2*t);
function lens_to_world(x, section) = [for(p=section) [x,rail_y(x)+p[0],p[1]]];

module lens_loft(rings, caps) {
    n=len(rings[0]);
    last=(len(rings)-1)*n;
    sides=[for(i=[0:len(rings)-2],j=[0:n-1])
               let(a=i*n+j,b=i*n+(j+1)%n) each [[a,a+n,b],[b,a+n,b+n]]];
    polyhedron(points=[for(r=rings) each r],faces=concat(caps,sides,
        [for(f=caps) [last+f[2],last+f[1],last+f[0]]]),convexity=12);
}

function lens_shield_ring(x) =
    let(front=insertion-side_depth, level=13, top=level+edge,
        low=top-lens_lower_depth(x), u=abs(x)/(chord/2),
        // A borda periférica termina nos dois lados do recorte nasal.
        // A altura da faixa e a posição dos dois términos são ilustrativas.
        side=lens_smooth(max(0,min(1,(u-0.15)/0.08))),
        lower=edge+(rim-edge)*side, height=min(2.8,0.70*(level-low)),
        // Linhas [Z, espessura do escudo em Y]. A pele do escudo fica à
        // frente do piso. A aba horizontal apoia sua face inferior em Z=13.
        rows=concat([[low,lower]],[for(t=[0,1/3,2/3,1])
            [low+height*(0.58+0.42*t),lower+(edge-lower)*lens_smooth(t)]],[[level,edge]]),
        sec=concat([[front,low]],[for(r=rows) [front+r[1],r[0]]],
                   [[insertion,level],[insertion,top],[front,top]],
                   [for(i=[len(rows)-1:-1:1]) [front,rows[i][0]]]))
    lens_to_world(x,sec);

module lens_shield(stations) {
    rings=[for(x=stations) lens_shield_ring(x)];
    n=len(rings[0]);
    m=(n-3)/2;
    // Fecha a pele do escudo em faixas e a aba horizontal no topo do L.
    caps=concat([for(i=[0:m-2]) let(a=(n-i)%n,b=i+1,d=n-i-1)
                     each [[a,b,b+1],[a,b+1,d]]],
                [[m+4,m,m+3],[m,m+2,m+3],[m,m+1,m+2]]);
    lens_loft(rings,caps);
}

module lens_tooth(c,stations) {
    a=c-boss_width/2;
    b=c+boss_width/2;
    z=13+edge;
    face=insertion-shoulder;
    // O pé mede boss_depth em Y. A ponta livre permanece lisa.
    // A interseção de 0,10 mm fica dentro da aba para unir o ressalto à lente.
    section=[[face,z-.10],[face+boss_depth,z-.10],
             [face+boss_depth,13+raised],[face,13+raised]];
    _of_sweep([for(x=stations) if(x>=a-1e-8 && x<=b+1e-8)
        lens_to_world(x,section)]);
}

module lens() {
    assert(boss_depth>0 && shoulder>boss_depth && shoulder<insertion-.12 &&
           shoulder<side_depth && side_depth>edge && raised>=edge && rim>0 &&
           spacing>boss_width && spacing+boss_width/2<chord/2);
    stations=lens_stations();
    union() {
        lens_shield(stations);
        if(raised>edge)
            for(c=[-spacing,0,spacing]) lens_tooth(c,stations);
    }
